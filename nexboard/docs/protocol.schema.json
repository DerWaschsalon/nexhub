          "type": "string"
        },
        "artist": {
          "default": "",
          "title": "Artist",
          "type": "string"
        },
        "player": {
          "default": "",
          "title": "Player",
          "type": "string"
        }
      },
      "title": "Track",
      "type": "object"
    },
    "UsageLimit": {
