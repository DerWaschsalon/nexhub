          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "title": "ServerInfo",
      "type": "object"
    },
    "State": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "state",
          "default": "state",
          "title": "Type",
          "type": "string"
        },
        "full": {
          "default": false,
          "title": "Full",
          "type": "boolean"
