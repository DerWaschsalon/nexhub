        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maxLength": 16,
          "title": "Id",
          "type": "string"
        },
        "w": {
          "anyOf": [
            {
              "maximum": 160,
              "minimum": 8,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "W"
        },
        "h": {
          "anyOf": [
            {
              "maximum": 160,
              "minimum": 8,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H"
        },
        "y": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "type": {
          "const": "art",
          "default": "art",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Art",
      "type": "object"
    },
    "ArtRequest": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "art_request",
          "default": "art_request",
          "title": "Type",
          "type": "string"
        },
        "size": {
          "maximum": 160,
          "minimum": 8,
          "title": "Size",
          "type": "integer"
        },
        "have": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Have"
        }
      },
      "required": [
        "size"
      ],
      "title": "ArtRequest",
      "type": "object"
    },
    "Background": {
      "description": "Hintergrund der Leiste, immer bildschirmgroß.",
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "id": {
          "maxLength": 16,
          "title": "Id",
          "type": "string"
        },
        "w": {
          "anyOf": [
            {
              "maximum": 640,
              "minimum": 640,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "W"
        },
        "h": {
          "anyOf": [
            {
              "maximum": 172,
              "minimum": 172,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "H"
        },
        "y": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "rows": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rows"
        },
        "data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data"
        },
        "type": {
          "const": "bg",
          "default": "bg",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "Background",
      "type": "object"
    },
    "ClaudeUsage": {
      "properties": {
        "session": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageLimit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "week": {
          "anyOf": [
            {
              "$ref": "#/$defs/UsageLimit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ClaudeUsage",
      "type": "object"
    },
    "DeviceInfo": {
      "properties": {
        "id": {
          "maxLength": 64,
          "title": "Id",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "fw": {
          "anyOf": [
            {
              "maxLength": 32,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fw"
        },
        "width": {
          "minimum": 1,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "minimum": 1,
          "title": "Height",
          "type": "integer"
        },
        "sim": {
          "default": false,
          "title": "Sim",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "width",
        "height"
      ],
      "title": "DeviceInfo",
      "type": "object"
    },
    "Dps": {
      "properties": {
        "target": {
          "title": "Target",
          "type": "string"
        },
        "time": {
          "minimum": 0,
          "title": "Time",
          "type": "integer"
        },
        "hp": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hp"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/DpsRow"
          },
          "maxItems": 8,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "target",
        "time",
        "rows"
      ],
      "title": "Dps",
      "type": "object"
    },
    "DpsRow": {
      "properties": {
        "name": {
          "maxLength": 24,
          "title": "Name",
          "type": "string"
        },
        "cls": {
          "anyOf": [
            {
              "enum": [
                "gladiator",
                "templar",
                "assassin",
                "ranger",
                "sorcerer",
                "spiritmaster",
                "cleric",
                "chanter",
                "brawler"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cls"
        },
        "dps": {
          "minimum": 0,
          "title": "Dps",
          "type": "integer"
        },
        "dmg": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dmg"
        },
        "pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pct"
        },
        "you": {
          "default": false,
          "title": "You",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "dps"
      ],
      "title": "DpsRow",
      "type": "object"
    },
    "Error": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "enum": [
            "auth",
            "version",
            "bad_request",
            "disabled"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code"
      ],
      "title": "Error",
      "type": "object"
    },
    "Event": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
