            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "cols": {
          "default": 6,
          "maximum": 8,
          "minimum": 1,
          "title": "Cols",
          "type": "integer"
        },
        "rows": {
          "default": 2,
          "maximum": 3,
          "minimum": 1,
          "title": "Rows",
          "type": "integer"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Item"
          },
          "maxItems": 24,
          "title": "Items",
          "type": "array"
        }
