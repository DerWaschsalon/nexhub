            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dps": {
          "anyOf": [
            {
              "$ref": "#/$defs/Dps"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dps_active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dps Active"
        },
        "claude": {
          "anyOf": [
            {
              "$ref": "#/$defs/ClaudeUsage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "StateValues",
      "type": "object"
    },
    "Theme": {
      "properties": {
        "accent": {
          "default": "#5AC8FA",
          "pattern": "^#[0-9A-Fa-f]{6}$",
