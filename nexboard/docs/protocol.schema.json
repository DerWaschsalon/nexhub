        "event": {
          "enum": [
            "button_press",
            "long_press",
            "slider_change",
            "page_change"
          ],
          "title": "Event",
          "type": "string"
        },
        "item": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item"
        },
        "part": {
          "anyOf": [
            {
              "enum": [
                "prev",
                "toggle",
                "next",
                "reset"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Part"
        },
        "page": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "final": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Final"
        }
      },
      "required": [
        "event"
      ],
      "title": "Event",
      "type": "object"
    },
    "Goto": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "goto",
          "default": "goto",
          "title": "Type",
          "type": "string"
        },
        "page": {
          "pattern": "^[A-Za-z0-9_-]{1,32}$",
          "title": "Page",
          "type": "string"
        }
      },
      "required": [
        "page"
      ],
      "title": "Goto",
      "type": "object"
    },
    "Heartbeat": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "enum": [
            "ping",
            "pong"
          ],
          "title": "Type",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "integer"
        }
      },
      "required": [
        "type",
        "t"
      ],
      "title": "Heartbeat",
      "type": "object"
    },
    "Hello": {
      "properties": {
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "hello",
          "default": "hello",
          "title": "Type",
          "type": "string"
        },
        "token": {
          "maxLength": 128,
          "title": "Token",
          "type": "string"
        },
        "layout_hash": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout Hash"
        },
        "page": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "bg_id": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bg Id"
        },
        "caps": {
          "default": [],
          "items": {
            "maxLength": 16,
            "type": "string"
          },
          "title": "Caps",
          "type": "array"
        },
        "device": {
          "$ref": "#/$defs/DeviceInfo"
        }
      },
      "required": [
        "token",
        "device"
      ],
      "title": "Hello",
      "type": "object"
    },
