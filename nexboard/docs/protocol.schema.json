        "max": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "nav": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nav"
        },
        "players": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Players"
        },
        "extra": {
          "anyOf": [
            {
              "enum": [
                "pct",
                "dmg",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extra"
        },
        "w": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "W",
          "type": "integer"
        },
        "h": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "title": "H",
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "title": "Item",
      "type": "object"
    },
    "LayoutMessage": {
      "properties": {
        "theme": {
          "$ref": "#/$defs/Theme"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/Page"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Pages",
          "type": "array"
        },
        "v": {
          "const": 1,
          "default": 1,
          "title": "V",
          "type": "integer"
        },
        "type": {
          "const": "layout",
          "default": "layout",
          "title": "Type",
          "type": "string"
