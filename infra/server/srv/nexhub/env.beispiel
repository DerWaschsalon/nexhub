# Vorlage für /srv/nexhub/.env (Rechte 600, nie ins Repo).
# Geheimnisse erzeugen: openssl rand -base64 32 | tr -d '/+='

# Leer lassen, solange es keine Domain gibt (dann nur http auf Port 80)
HUB_DOMAIN=
# Leer = Caddy nur auf 127.0.0.1 (SSH-Tunnel). Mit Domain: 0.0.0.0
HUB_BIND=
# Nur wenn HUB_DOMAIN eine IP ist: dieselbe IP (Clients schicken dafür kein SNI)
HUB_DEFAULT_SNI=
POSTGRES_PASSWORD=

# Adresse im Browser. Ohne Domain per Tunnel: ssh -L 8080:127.0.0.1:80 waschsalon
# Mit Domain: https://<domain>. Discord braucht <HUB_BASE_URL>/api/auth/callback als Redirect.
HUB_BASE_URL=http://localhost:8080
HUB_SECRET_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Discord-IDs der Admins, kommagetrennt
HUB_ADMIN_IDS=
# Optional: Mitglied ist, wer auf diesem Server diese Rolle hat (sonst nur Admins)
HUB_GUILD_ID=
HUB_MEMBER_ROLE_ID=

# TheWashBot im selben Stack. Erst einschalten, wenn er auf dem alten Server gestoppt ist
# (siehe infra/README.md, Abschnitt Bot-Umzug). Weitere Einstellungen des Bots: bot.env
#COMPOSE_PROFILES=bot
BOT_CONTROL_URL=http://bot:8790
# Gemeinsamer Schlüssel für Hub und Bot, mindestens 24 Zeichen
BOT_CONTROL_KEY=

# Impressum und Datenschutz (/impressum, /datenschutz) – öffentlich sichtbar, deshalb nur hier und nie
# im Repo. Anschrift: Zeilen mit ";" trennen. Leer: die Seiten sagen „noch nicht eingetragen“.
HUB_OPERATOR_NAME=
HUB_OPERATOR_ADDRESS=
HUB_OPERATOR_EMAIL=
# Wo der Server läuft, z. B. "<Anbieter>, Deutschland" (für die Datenschutzerklärung)
HUB_HOSTER=
# Charakterprofile von der AION-2-Website (Standard: an, de-DE, 0.3 s Pause)
#HUB_AION2_ENABLED=1
#HUB_AION2_LANG=de-DE
#HUB_AION2_PAUSE=0.3
