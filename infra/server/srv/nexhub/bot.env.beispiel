# Vorlage für /srv/nexhub/bot.env (Rechte 600, nie ins Repo). Alle Optionen: bot/.env.example.
# BOT_CONTROL_KEY steht in .env, weil der Hub ihn auch braucht.

# Pflicht: Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=
# ID eures Discord-Servers (Befehle sofort sichtbar, Hub steuert diesen Server)
DEV_GUILD_ID=

# Öffentliche Adresse des Hubs (wie HUB_BASE_URL mit Domain). Caddy leitet /api/aion/*, /runs/*,
# /leaderboard/* und /dps/* an den Bot weiter.
AION_PUBLIC_URL=
DPS_PUBLIC_URL=

GITHUB_TOKEN=
NOTIFY_POLL_MINUTES=10
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YTDLP_AUTOUPDATE=1
LOG_LEVEL=INFO

# Das alte Web-Dashboard des Bots (Port 8789, eigener Discord-Login) ersetzt der Bereich „Bot“
# im Hub. Ohne DISCORD_CLIENT_ID/SECRET hier ist sein Login aus; Caddy gibt ihn nicht nach außen.
