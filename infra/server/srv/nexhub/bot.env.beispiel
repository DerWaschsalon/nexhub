# Vorlage für /srv/nexhub/bot.env (Rechte 600, nie ins Repo). Alle Optionen: bot/.env.example.
# BOT_CONTROL_KEY steht in .env, weil der Hub ihn auch braucht.

# Pflicht: Token aus dem Discord Developer Portal (Bot → Reset Token)
DISCORD_TOKEN=
# ID eures Discord-Servers (Befehle sofort sichtbar, Hub steuert diesen Server)
DEV_GUILD_ID=

# Öffentliche Adresse des Hubs (wie HUB_BASE_URL mit Domain). Caddy leitet /api/aion/* und
# /leaderboard/* an den Bot weiter.
AION_PUBLIC_URL=

GITHUB_TOKEN=
NOTIFY_POLL_MINUTES=10
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YTDLP_AUTOUPDATE=1
LOG_LEVEL=INFO

# Einstellungen des Bots ändert man im Hub (Bereich „Bot“) oder in Discord mit /setup.
