#!/usr/bin/env python3
"""Prototyp: modulares Overlay als layer-shell-Fläche (KDE Plasma 6, Wayland).

Ein einziges, transparentes Fenster deckt einen Monitor ab (Ebene „overlay“, über dem
Vollbildspiel). Die Widgets sind DOM-Elemente der Seite page/index.html. Klicks gehen ans Spiel
durch, außer im Bearbeiten-Modus. Tastatur bekommt das Fenster nie, außer im Bearbeiten-Modus.

    layer-proto [--screen DP-1] [--edit] [--software] [--quit-after SEK]
    layer-proto --cmd edit|lock|toggle|quit      an die laufende Instanz

Modi:
    lock   (Standard) ganz klickdurchlässig (Qt::WindowTransparentForInput)
    click  nur die Widgets mit data-click (z. B. Meter-Knöpfe) nehmen Klicks an, Rest geht durch
    edit   das ganze Fenster nimmt Klicks an: Widgets ziehen, Mausrad = Größe, Esc = fertig

Braucht layer-shell-qt (QML-Modul org.kde.layershell), PySide6, qt6-webengine.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

os.environ["QT_QPA_PLATFORM"] = "wayland"  # layer-shell gibt es nur unter Wayland, nicht unter XWayland

from PySide6.QtCore import Property, QObject, QRect, QTimer, QUrl, Qt, Signal, Slot
from PySide6.QtGui import QGuiApplication, QRegion
from PySide6.QtNetwork import QLocalServer, QLocalSocket
from PySide6.QtQml import QQmlApplicationEngine

HERE = Path(__file__).resolve().parent
SOCKET = "deckbar-layer-proto"
LAYOUT = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "deckbar" / "overlay" / "layout-proto.json"
MODES = ("lock", "click", "edit")


class Host(QObject):
    """Kontext-Objekt „host“ in QML. Die Seite erreicht es über die WebChannel-Brücke."""

    modeChanged = Signal(str)

    def __init__(self, page: QUrl, meter: str) -> None:
        super().__init__()
        self._mode = "lock"
        self._page = page
        self._meter = meter
        css = (HERE / "page" / "effects.css").read_text()
        self._frame_script = (HERE / "page" / "frame-effects.js").read_text().replace("__EFFECTS_CSS__", json.dumps(css))
        self._rects: list[QRect] = []
        self.window = None

    @Property(str, notify=modeChanged)
    def mode(self) -> str:
        return self._mode

    @Property(QUrl, constant=True)
    def pageUrl(self) -> QUrl:
        return self._page

    @Property(str, constant=True)
    def meterUrl(self) -> str:
        return self._meter

    @Property(str, constant=True)
    def frameScript(self) -> str:
        return self._frame_script

    def set_mode(self, mode: str) -> None:
        if mode not in MODES or mode == self._mode:
            return
        self._mode = mode
        self.apply_input()
        self.modeChanged.emit(mode)

    def apply_input(self) -> None:
        """Eingabe-Region setzen: leer (lock), nur Widgets (click) oder alles (edit)."""
        w = self.window
        if w is None:
            return
        if self._mode == "edit":
            w.setFlag(Qt.WindowTransparentForInput, False)
            w.setMask(QRegion())  # leere Maske = keine Maske = ganzes Fenster
        elif self._mode == "click" and self._rects:
            region = QRegion()
            for r in self._rects:
                region = region.united(QRegion(r))
            w.setFlag(Qt.WindowTransparentForInput, False)
            w.setMask(region)
        else:
            w.setFlag(Qt.WindowTransparentForInput, True)  # zuerst: sonst kurz ganze Fläche klickbar
            w.setMask(QRegion())

    @Slot(str)
    def setClickRects(self, text: str) -> None:
        """Rechtecke [[x, y, w, h], …] der Widgets, die im Modus „click“ Klicks annehmen."""
        try:
            self._rects = [QRect(*(int(round(v)) for v in r)) for r in json.loads(text)]
        except (ValueError, TypeError):
            return
        if self._mode == "click":
            self.apply_input()

    @Slot(str)
    def requestMode(self, mode: str) -> None:
        self.set_mode(mode)

    @Slot(result=str)
    def loadLayout(self) -> str:
        try:
            return LAYOUT.read_text()
        except OSError:
            return "{}"

    @Slot(str)
    def saveLayout(self, text: str) -> None:
        LAYOUT.parent.mkdir(parents=True, exist_ok=True)
        tmp = LAYOUT.with_suffix(".tmp")
        tmp.write_text(text)
        tmp.replace(LAYOUT)

    @Slot(str)
    def log(self, text: str) -> None:
        print(f"[page] {text}", flush=True)


def send(cmd: str) -> int:
    sock = QLocalSocket()
    sock.connectToServer(SOCKET)
    if not sock.waitForConnected(1000):
        print("läuft nicht", file=sys.stderr)
        return 1
    sock.write(cmd.encode() + b"\n")
    sock.waitForBytesWritten(1000)
    sock.disconnectFromServer()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--screen", default="DP-1", help="Ausgang (kscreen-doctor -o), Standard DP-1")
    ap.add_argument("--edit", action="store_true", help="im Bearbeiten-Modus starten")
    ap.add_argument("--software", action="store_true", help="ohne Chromium-GPU-Compositing (zum Vergleich; unter layer-shell nicht nötig)")
    ap.add_argument("--quit-after", type=float, default=0, help="nach SEK Sekunden beenden (Tests)")
    ap.add_argument("--meter", default="http://127.0.0.1:8766/", help="URL der Meter-Oberfläche (a2ui.py)")
    ap.add_argument("--cmd", choices=("edit", "lock", "click", "toggle", "quit"))
    args = ap.parse_args()

    if args.software:
        os.environ.setdefault("QTWEBENGINE_CHROMIUM_FLAGS", "--disable-gpu-compositing")

    from PySide6.QtWebEngineQuick import QtWebEngineQuick
    QtWebEngineQuick.initialize()
    app = QGuiApplication(sys.argv[:1])
    if args.cmd:
        return send(args.cmd)

    screen = next((s for s in app.screens() if s.name() == args.screen), None)
    if screen is None:
        print(f"Ausgang {args.screen} nicht gefunden: {[s.name() for s in app.screens()]}", file=sys.stderr)
        return 1

    host = Host(QUrl.fromLocalFile(str(HERE / "page" / "index.html")), args.meter)
    engine = QQmlApplicationEngine()
    engine.rootContext().setContextProperty("host", host)
    engine.load(QUrl.fromLocalFile(str(HERE / "Overlay.qml")))
    if not engine.rootObjects():
        return 1
    win = engine.rootObjects()[0]
    host.window = win
    win.setScreen(screen)
    win.resize(screen.size())
    host.apply_input()  # vor dem Zeigen: sonst blockiert die Fläche kurz das Spiel
    win.show()
    if args.edit:
        host.set_mode("edit")

    server = QLocalServer()
    QLocalServer.removeServer(SOCKET)
    server.listen(SOCKET)

    def on_conn() -> None:
        sock = server.nextPendingConnection()

        def read() -> None:
            for line in bytes(sock.readAll()).decode().split():
                if line == "quit":
                    app.quit()
                elif line == "toggle":
                    host.set_mode("lock" if host.mode == "edit" else "edit")
                else:
                    host.set_mode(line)
        sock.readyRead.connect(read)
    server.newConnection.connect(on_conn)

    if args.quit_after:
        QTimer.singleShot(int(args.quit_after * 1000), app.quit)
    print(f"Overlay auf {screen.name()} {screen.geometry().width()}x{screen.geometry().height()}, Modus {host.mode}", flush=True)
    return app.exec()


if __name__ == "__main__":
    sys.exit(main())
