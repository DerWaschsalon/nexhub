[Unit]
Description=DeckBar-Overlay (AION-2-DPS-Meter am PC, Tray)
Documentation=file://%h/Github/deckbar/README.md
PartOf=graphical-session.target
After=graphical-session.target deckbar.service

[Service]
Type=simple
ExecStart=%h/.local/bin/deckbar-overlay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
