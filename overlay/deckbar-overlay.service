[Unit]
Description=NexBoard-Overlay (Meter und Widgets über dem Spiel, Tray)
Documentation=https://github.com/gamunex/deckbar
PartOf=graphical-session.target
After=graphical-session.target deckbar.service

[Service]
Type=simple
ExecStart=%h/.local/bin/deckbar-overlay
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
